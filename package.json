{
  "name": "first-value-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.12.0 || >=24.0.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
